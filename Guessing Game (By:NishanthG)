import random
import time
from datetime import datetime

print("=" * 40)
print("      LUCKY NUMBER GUESSING GAME")
print("=" * 40)

# Display current date and time
now = datetime.now()
print("Current Date & Time:", now.strftime("%d-%m-%Y %H:%M:%S"))

print("\nI have selected a number between 1 and 20.")
print("Can you guess it?")

number = random.randint(1, 20)

attempts = 5

for i in range(1, attempts + 1):
    guess = int(input(f"\nAttempt {i}/{attempts}: Enter your guess: "))

    time.sleep(1)

    if guess == number:
        print("🎉 Congratulations! You guessed the correct number.")
        break

    elif guess < number:
        print("Too Low!")

    else:
        print("Too High!")

else:
    print("\nGame Over!")
    print("The correct number was:", number)
print("\nThanks for playing!")
