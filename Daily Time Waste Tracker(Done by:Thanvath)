
# Dictionary to store activities and wasted time
time_waste = {}

print("=== Daily Time Waste Tracker ===")

while True:
    print("\n1. Add Activity")
    print("2. View Report")
    print("3. Save Report")
    print("4. Exit")

    choice = input("Enter your choice: ")

    # Add activity
    if choice == '1':
        activity = input("Enter activity name: ")
        minutes = int(input("Enter time wasted (in minutes): "))

        if activity in time_waste:
            time_waste[activity] += minutes
        else:
            time_waste[activity] = minutes

        print(f"{minutes} minutes added to {activity}")

    # View report
    elif choice == '2':
        print("\n--- Daily Waste Report ---")

        total = 0

        if len(time_waste) == 0:
            print("No data available.")
        else:
            for activity, minutes in time_waste.items():
                print(f"{activity} : {minutes} minutes")
                total += minutes

            print(f"\nTotal Time Wasted: {total} minutes")

    # Save report
    elif choice == '3':
        file = open("time_waste_report.txt", "w")

        total = 0

        file.write("Daily Time Waste Report\n")
        file.write("-------------------------\n")

        for activity, minutes in time_waste.items():
            file.write(f"{activity} : {minutes} minutes\n")
            total += minutes

        file.write(f"\nTotal Time Wasted: {total} minutes")

        file.close()

        print("Report saved successfully!")

    # Exit
    elif choice == '4':
        print("Exiting program...")
        break

    else:
        print("Invalid choice! Try again.")
